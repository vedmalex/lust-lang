-- Lust Lang Testing Framework (@std/test / std.test) - Syntax Showcase
-- Demonstrates first-class test declarations, nested suites, lifecycle hooks,
-- test modifiers (.skip, .timeout, .only), and effect-aware assertions.

-- 1. Root level standalone test
test "basic arithmetic and equality assertions" do
    local x = 10
    local y = 20
    local sum = x + y
    
    assert_eq(sum, 30)
    assert_ne(sum, 0)
    assert_almost_eq(3.14159, 3.14150, 0.001)
end

-- 2. Standalone test with timeout modifier
test.timeout(3000) "network handshake within deadline" do
    local deadline_ms = 2500
    local connected = true
    assert(connected, "TCP connection established")
end

-- 3. Standalone test with skip modifier
test.skip("requires external redis instance in CI") "redis cluster failover probe" do
    local ping_response = "PONG"
    assert_eq(ping_response, "PONG")
end

-- 4. Full test suite with lifecycle hooks and nested suites
suite "E-Commerce Checkout & Payment Suite" do
    -- Setup hook executed before each test in this suite
    before_each do
        local db_tx = 1001
        local log_level = 2
    end

    -- Teardown hook executed after each test in this suite
    after_each do
        local rollback = true
    end

    -- One-time suite setup and teardown
    before_all do
        local schema_version = 42
    end

    after_all do
        local audit_logged = true
    end

    test "calculates subtotal and VAT correctly" do
        local price = 100.0
        local vat_rate = 0.20
        local total = price * (1.0 + vat_rate)
        
        assert_almost_eq(total, 120.0, 0.01)
        assert_ne(total, price)
    end

    test.skip("payment sandbox under scheduled maintenance") "authorizes credit card transaction" do
        local card_valid = true
        assert(card_valid, "Credit card must be valid")
    end

    -- Nested test suite (describe block)
    describe "Effect System & Failure Handling" do
        test "pure effect execution succeeds" do
            -- Emulate effect exit result
            local exit_code = 0
            assert_eq(exit_code, 0)
            assert_success(exit_code)
        end

        test "recoverable error produces typed failure" do
            local err_code = 1
            assert_fails(err_code)
        end

        test.timeout(500) "infinite loop fiber interruption" do
            local interrupt_signal = 4
            assert_interrupted(interrupt_signal)
        end
    end
end
